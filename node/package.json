{
  "name": "@myidii/node",
  "version": "0.1.0",
  "description": "MYIDII server SDK for Node.js: create sessions, read results and verify webhooks",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vectors": "node scripts/webhook-vectors.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "myidii",
    "liveness",
    "verification",
    "kyc",
    "webhooks"
  ],
  "homepage": "https://github.com/myidii/sdk-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myidii/sdk-server.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/myidii/sdk-server/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
